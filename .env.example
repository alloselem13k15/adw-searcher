# ============================================================
# ADW Searcher — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer le fichier .env
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
APP_NAME="ADW Searcher"
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Base de donnees PostgreSQL ───────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adw_searcher
POSTGRES_USER=adw_user
POSTGRES_PASSWORD=CHANGE_ME_secure_db_password
DATABASE_URL="postgresql://adw_user:CHANGE_ME_secure_db_password@localhost:5432/adw_searcher?schema=public"

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL="redis://:CHANGE_ME_redis_password@localhost:6379"

# ── JWT & Sessions ───────────────────────────────────────────
JWT_SECRET=CHANGE_ME_minimum_64_char_secret_for_jwt_signing_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_minimum_64_char_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=CHANGE_ME_minimum_64_char_secret_for_sessions

# ── Argon2 (hachage des mots de passe) ──────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ── Email (Resend / SMTP) ────────────────────────────────────
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM="ADW Searcher <noreply@adw-searcher.com>"
# Alternative SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME@gmail.com
SMTP_PASS=CHANGE_ME

# ── Stripe (Paiements) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# Plans Stripe (IDs des prix)
STRIPE_PRICE_BASIC_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_PREMIUM_MONTHLY=price_CHANGE_ME
STRIPE_PRICE_BUSINESS_MONTHLY=price_CHANGE_ME

# ── ADW API (serveur uniquement — ne jamais exposer au client) ──
# IMPORTANT: Ces variables ne doivent JAMAIS apparaitre dans le code client
# Contactez le support pour obtenir vos identifiants ADW API
ADW_API_KEY=CHANGE_ME_adw_api_key
ADW_API_URL=CHANGE_ME_contact_support_for_url
ADW_API_TIMEOUT=30000

# ── OTP / 2FA ────────────────────────────────────────────────
TOTP_ISSUER="ADW Searcher"
OTP_SECRET_KEY=CHANGE_ME_otp_encryption_key_32chars

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
SEARCH_RATE_LIMIT_MAX=20
SEARCHES_PER_DAY_DEFAULT=100

# ── Upload de fichiers ───────────────────────────────────────
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ── Securite ─────────────────────────────────────────────────
BCRYPT_ROUNDS=12
CSRF_SECRET=CHANGE_ME_csrf_secret
CORS_ORIGINS=http://localhost:3000

# ── Logs ─────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ── Feature Flags ────────────────────────────────────────────
MAINTENANCE_MODE=false
REGISTRATION_ENABLED=true
